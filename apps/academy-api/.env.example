# Elder Futhark Academy — API
# Copy to .env and fill in. Never commit the filled copy.
# Required vars are asserted at boot by src/config/env.js (assertEnv).

# --- Required ---
# MongoDB connection string. Percent-encode any reserved characters in the
# password (@ : / ? # [ ] %) or the URI will not parse.
MONGODB_URI=mongodb://localhost:27017/elder-futhark-academy
# Signing secret for JWTs. Use a long random value, not a phrase.
JWT_SECRET=replace-me-with-a-long-random-string

# --- Optional (defaults shown) ---
NODE_ENV=development
PORT=4000
JWT_EXPIRES_IN=7d
# Comma-separated allowlist of browser origins. Empty = allow all (dev only).
# Production must set this to the deployed web origin.
CLIENT_ORIGIN=http://localhost:5173
