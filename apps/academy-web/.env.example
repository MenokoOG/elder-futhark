# Elder Futhark Academy — web client
# Copy to .env and fill in. Only VITE_-prefixed vars reach the browser bundle,
# so never put a secret in this file.

# Base URL of the API, including the /api suffix.
#   local:  http://localhost:4000/api
#   render: https://<your-api-service>.onrender.com/api
# Defaults to http://localhost:4000/api if unset.
VITE_API_BASE_URL=http://localhost:4000/api
