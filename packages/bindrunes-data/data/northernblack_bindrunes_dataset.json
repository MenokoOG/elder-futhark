  "bind_rune_basics": {
    "definition": "A bind rune combines two or more individual runes into a single symbol that blends their meanings.",
    "stated_uses": [
      "practical abbreviation or signature",
      "decorative art",
      "magical intent"
    ],
    "historical_framing": {
      "viking_age": "Rare but attested; often treated as practical or space-saving in inscriptions.",
      "icelandic_esoteric": "Later post-medieval magical stave tradition overlaps with related sigil-like forms.",
      "modern": "Used for personal art, inspiration, empowerment, divination, and contemporary magical practice."
    }
  },
