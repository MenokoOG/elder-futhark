{
  "name": "elder-futhark-etl",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "clean": "rimraf data/raw/* data/extracted/* data/normalized/* data/curated/* dist .turbo",
    "dev": "pnpm --filter @efa/cli dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "cli": "pnpm --filter @efa/cli cli"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "eslint": "^9.25.1",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
